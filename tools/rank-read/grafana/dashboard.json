{
    "uid":  "daily-rank-read",
    "title":  "Daily rank read",
    "schemaVersion":  39,
    "refresh":  "5s",
    "time":  {
                 "from":  "now-15m",
                 "to":  "now"
             },
    "panels":  [
                   {
                       "id":  1,
                       "title":  "발행·성공 RPS",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "x":  0,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "rate(k6_rank_started_total[30s])",
                                           "legendFormat":  "발행 {{run_id}}"
                                       },
                                       {
                                           "refId":  "B",
                                           "expr":  "rate(k6_rank_succeeded_total[30s])",
                                           "legendFormat":  "성공 {{run_id}}"
                                       }
                                   ]
                   },
                   {
                       "id":  2,
                       "title":  "클라이언트 평균·p99",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "x":  12,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ms"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "1000 * k6_rank_e2e_avg",
                                           "legendFormat":  "평균 {{run_id}}"
                                       },
                                       {
                                           "refId":  "B",
                                           "expr":  "1000 * k6_rank_e2e_p99",
                                           "legendFormat":  "p99 {{run_id}}"
                                       }
                                   ]
                   },
                   {
                       "id":  3,
                       "title":  "오류율",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "x":  0,
                                       "y":  8,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percentunit"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "k6_rank_errors_rate",
                                           "legendFormat":  "{{run_id}}"
                                       }
                                   ]
                   },
                   {
                       "id":  4,
                       "title":  "측정 발행 누락",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "x":  12,
                                       "y":  8,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "increase(k6_dropped_iterations_total{scenario=\"measure\"}[30s])",
                                           "legendFormat":  "{{run_id}}"
                                       }
                                   ]
                   },
                   {
                       "id":  5,
                       "title":  "MySQL CPU",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "x":  0,
                                       "y":  16,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "100 * sum(rate(container_cpu_usage_seconds_total{name=\"mysql-geumpumta\"}[30s]))",
                                           "legendFormat":  "MySQL"
                                       }
                                   ]
                   },
                   {
                       "id":  6,
                       "title":  "Hikari 커넥션 대기",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "x":  12,
                                       "y":  16,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum(hikaricp_connections_pending)",
                                           "legendFormat":  "대기"
                                       }
                                   ]
                   },
                   {
                       "id":  7,
                       "title":  "Hikari 획득 평균",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "x":  0,
                                       "y":  24,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ms"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "1000 * sum(rate(hikaricp_connections_acquire_seconds_sum[30s])) / sum(rate(hikaricp_connections_acquire_seconds_count[30s]))",
                                           "legendFormat":  "획득"
                                       }
                                   ]
                   },
                   {
                       "id":  8,
                       "title":  "앱 랭킹 처리 평균·p99",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "x":  12,
                                       "y":  24,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ms"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "1000 * sum(rate(http_server_requests_seconds_sum{uri=\"/api/v1/rank/personal/daily\"}[30s])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/rank/personal/daily\"}[30s]))",
                                           "legendFormat":  "평균"
                                       },
                                       {
                                           "refId":  "B",
                                           "expr":  "1000 * histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v1/rank/personal/daily\"}[30s])))",
                                           "legendFormat":  "p99"
                                       }
                                   ]
                   },
                   {
                       "id":  9,
                       "title":  "클라이언트 연결·전송 p99",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "x":  0,
                                       "y":  32,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ms"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "1000 * k6_rank_connect_p99",
                                           "legendFormat":  "연결 {{run_id}}"
                                       },
                                       {
                                           "refId":  "B",
                                           "expr":  "1000 * k6_rank_transfer_p99",
                                           "legendFormat":  "전송 {{run_id}}"
                                       }
                                   ]
                   },
                   {
                       "id":  10,
                       "title":  "Tomcat 사용 스레드",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "x":  12,
                                       "y":  32,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum(tomcat_threads_busy_threads)",
                                           "legendFormat":  "사용 중"
                                       }
                                   ]
                   },
                   {
                       "id":  11,
                       "title":  "Client active VUs",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "y":  40,
                                       "w":  12,
                                       "h":  8,
                                       "x":  0
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "k6_vus"
                                       }
                                   ]
                   },
                   {
                       "id":  12,
                       "title":  "Redis and Spring CPU",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "y":  40,
                                       "w":  12,
                                       "h":  8,
                                       "x":  12
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "100 * sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"redis-geumpumta|.*rank-app.*\"}[30s]))"
                                       }
                                   ]
                   },
                   {
                       "id":  13,
                       "title":  "JVM GC pause",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "rank-read-prometheus"
                                      },
                       "gridPos":  {
                                       "y":  48,
                                       "w":  12,
                                       "h":  8,
                                       "x":  0
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ms"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "1000 * sum(rate(jvm_gc_pause_seconds_sum[30s])) / sum(rate(jvm_gc_pause_seconds_count[30s]))"
                                       }
                                   ]
                   }
               ]
}
